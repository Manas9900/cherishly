{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/cherishly-in.vercel.app/:match*",
      "destination": "/:match*",
      "permanent": false
    },
    {
      "source": "/cherishly.live/:match*",
      "destination": "/:match*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "https://cherishly-backend.manas0000singh.workers.dev/s/:slug"
    }
  ]
}
