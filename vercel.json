{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/cherishly-in.vercel.app/(.*)",
      "destination": "/$1",
      "permanent": false
    },
    {
      "source": "/cherishly.live/(.*)",
      "destination": "/$1",
      "permanent": false
    },
    {
      "source": "/cherishly.in/(.*)",
      "destination": "/$1",
      "permanent": false
    },
    {
      "source": "/cherishly-in.vercel.app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/cherishly.live",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/cherishly.in",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/s/(.*)",
      "destination": "/s"
    }
  ]
}
